# map:update-runtime — local automatic-update state; never commit.
.map/update-state.json
.map/update.lock
.map/provider-refresh.lock
.map/installer.lock
.map/gitignore.lock
# map:settings-local — per-user Claude Code approvals / autonomy posture; never commit
.claude/settings.local.json

# Go build artifacts
bin/
*.test
*.out
coverage.txt

# map:session-telemetry — состояние текущей сессии MAP, меняется на каждом ходу.
# Артефакты планирования (спека, блюпринт, ревью, wayfind-карты) остаются в git.
.map/*/token_accounting.json
.map/*/token_log.jsonl
.map/*/iteration_log.jsonl
.map/*/iteration_summary.json
.map/*/.token-meter-cache.json
.map/*/sessions/scratch/
